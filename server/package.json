{
  "name": "agent-debut-mcp",
  "version": "0.1.0",
  "description": "Agent Debut — an autonomous App Store Connect operator, exposed as an MCP server. Your agent builds the app. Agent Debut ships it.",
  "type": "module",
  "bin": {
    "agent-debut-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
